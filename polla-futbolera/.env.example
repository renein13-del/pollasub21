# Copiá este archivo a .env y completá los valores.
# cp .env.example .env

# Obligatorias
DATABASE_URL=postgres://usuario:password@localhost:5432/polla
ADMIN_PASSWORD=

# Servidor
PORT=3000

# URL pública de la app (usada para links en emails, etc.). En local podés dejarla vacía.
APP_URL=

# Envío de emails (opcional en local; si se omiten, no se envían correos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Resultados en vivo vía API-FOOTBALL (opcional)
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE_ID=
API_FOOTBALL_SEASON=
LIVE_SCORES_POLL_MINUTES=3
